[Unit]
Description=AvianVisitors kiosk audio to frame speaker
After=pulseaudio.service
Wants=pulseaudio.service

[Service]
ExecStart=/usr/bin/python3 /home/david/BirdNET-Pi/ops/wifi-display/frame-audio-relay.py
Restart=always
RestartSec=5
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native

[Install]
WantedBy=default.target
