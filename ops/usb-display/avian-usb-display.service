[Unit]
Description=AvianVisitors USB tablet reconnect
After=avian-display.service
Wants=avian-display.service
[Service]
Type=simple
User=david
Group=david
SupplementaryGroups=plugdev
Environment=HOME=/home/david
EnvironmentFile=/home/david/.config/avian-display/usb.env
ExecStart=/usr/bin/python3 /home/david/.local/lib/avianvisitors/usb-display.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
